{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/echopath-labs/relaypact/main/packages/contracts/schemas/adapter-support-matrix.schema.json",
  "title": "RelayPact adapter support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "routes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hostPackage", "executorPackage", "adapterPackage", "executionHarness", "status", "sourceIncluded", "rootPluginActivation", "prerequisites", "deterministicCheck", "liveSmoke"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "hostPackage": { "type": "string", "pattern": "^packages/[a-z0-9-]+$" },
          "executorPackage": { "type": "string", "pattern": "^packages/[a-z0-9-]+$" },
          "adapterPackage": { "type": "string", "pattern": "^packages/[a-z0-9-]+$" },
          "executionHarness": { "type": "string", "minLength": 1 },
          "status": { "enum": ["public-preview", "experimental", "planned"] },
          "sourceIncluded": { "type": "boolean" },
          "rootPluginActivation": { "type": "boolean" },
          "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "deterministicCheck": { "type": "string", "pattern": "^npm run check:[a-z0-9-]+$" },
          "liveSmoke": { "type": ["string", "null"] }
        }
      }
    }
  }
}
