{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/echopath-labs/agent-delegation-kit/contracts/task-envelope.schema.json",
  "title": "Agent Delegation Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "objective",
    "expectedOutcome",
    "repository",
    "scope",
    "instructions",
    "constraints",
    "validation",
    "requiredEvidence",
    "stopConditions",
    "resultFormat"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "objective": { "type": "string", "minLength": 1 },
    "expectedOutcome": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "workingDirectory", "dirtyTree"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "dirtyTree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow", "acknowledgedPaths"],
          "properties": {
            "allow": { "type": "boolean" },
            "acknowledgedPaths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths", "forbiddenPaths"],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "forbiddenPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "readablePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
        }
      }
    },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["git_preflight", "changed_paths", "validation_results", "executor_report"]
      },
      "uniqueItems": true
    },
    "stopConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "resultFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" }
      }
    },
    "executionProfile": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "reasoning": {
              "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "exposureMode": { "enum": ["sanitized", "trusted-worktree"] },
        "trustedWorktreeAcknowledged": { "type": "boolean" }
      }
    }
  }
}
